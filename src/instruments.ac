// Field 3: non-invasive readings, sampled once per five rendered frames.
// R/R0 and V/V0 refer to the initial circular launch. Recover the instantaneous
// velocity from leapfrog's forward half-step: v = (v_half + inward_kick/2)/1024.
instrument_update,dac i_return
        lem
        lac i_countdown
        sza
        jmp i_skip
        law 4
        dac i_countdown
        jmp i_begin
i_skip,lac i_countdown
        sub [1]
        dac i_countdown
        cla
        eem
        jmp i i_return
i_begin,eem
        lac i [px:0]
        lem
        dac i_value
        mul i_value
        dac i_sum
        eem
        lac i [py:0]
        lem
        dac i_value
        mul i_value
        add i_sum
        sal 3s
        dac i_value
        jsp i_sqrt
        lac i_root
        dac i_radius
        mul [0d25]
        dio i_low
        lac i_low
        add [0d32]
        rar 6s
        and [01777]
        eem
        dac i [instrument_radius:0]
        lem
        eem
        lac i [ax:0]
        lem
        sar 1s
        dac i_temp
        eem
        lac i [vx:0]
        lem
        add i_temp
        dac i_value
        jsp i_square
        dac i_speed2
        eem
        lac i [ay:0]
        lem
        sar 1s
        dac i_temp
        eem
        lac i [vy:0]
        lem
        add i_temp
        dac i_value
        jsp i_square
        add i_speed2
        dac i_speed2
        dac i_value
        jsp i_sqrt
        lac i_root
        mul [0d25]
        dio i_low
        lac i_low
        add [0d16]
        rar 5s
        and [01777]
        eem
        dac i [instrument_speed:0]
        lem
        lac i_speed2
        mul i_radius
        dac i_high
        dio i_low
        jsp i_extract12
        dac i_energy128
        sub [0d252]
        spa
        jmp i_bound_case
        sub [0d9]
        spa
        jmp i_near_case
        law 2
        jmp i_class
i_near_case,law 1
        jmp i_class
i_bound_case,cla
i_class,eem
        dac i [instrument_energy:0]
        law 1
        jmp i i_return
// Integer square root, exact floor, at most nine iterations; no floating point.
i_sqrt,dap i_sqrtret
        dzm i_root
        lac [0d65536]
        dac i_bit
i_sqrtloop,lac i_root
        add i_bit
        dac i_trial
        lac i_value
        sub i_trial
        spa
        jmp i_no_sub
        dac i_value
        lac i_root
        sar 1s
        add i_bit
        dac i_root
        jmp i_next_bit
i_no_sub,lac i_root
        sar 1s
        dac i_root
i_next_bit,lac i_bit
        sar 2s
        dac i_bit
        sza
        jmp i_sqrtloop
        jmp i i_sqrtret
i_square,dap i_squareret
        lac i_value
        mul i_value
        dac i_high
        dio i_low
        jsp i_extract8
        jmp i i_squareret
// Preserve enough product bits for speed at roughly 0.01..0.02 resolution.
i_extract8,dap i_extractret
        lac i_low
        rar 9s
        and [0777]
        dac i_low
        lac i_high
        sal 9s
        ior i_low
        jmp i i_extractret
// speed^2 is Q12; radius is Q7. Shift the energy product to Q7.
i_extract12,dap i_extractret
        lac i_low
        rar 9s
        rar 4s
        and [037]
        dac i_low
        lac i_high
        sal 5s
        ior i_low
        jmp i i_extractret
i_return,0
i_countdown,0
i_value,0
i_sum,0
i_root,0
i_radius,0
i_speed2,0
i_energy128,0
i_temp,0
i_low,0
i_high,0
i_bit,0
i_trial,0
i_sqrtret,0
i_squareret,0
i_extractret,0
constants
assert . < 010000, "instrument code exceeds field 3"
